# Supabase (https://supabase.com → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key

# PayOS (https://my.payos.vn → Kênh thanh toán)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# UNICOACH LMS — nối SSO + đẩy điểm về (xem INTEGRATION.md bên repo unicoach-bms)
# Khóa SSO: LMS → ⚙️ Quản trị hệ thống → Ứng dụng liên kết → WriteRight → 🔑 Khóa SSO
UNICOACH_SSO_SECRET=
# Địa chỉ LMS, không có dấu / ở cuối
UNICOACH_LMS_URL=https://lms.unicoach.vn
# API key quyền "Đọc + ghi": LMS → ⚙️ Quản trị hệ thống → API mở
UNICOACH_API_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FREE_TIER_LIMIT=5
